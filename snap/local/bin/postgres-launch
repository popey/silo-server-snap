#!/bin/bash
set -euo pipefail
# shellcheck source=snap/local/lib/common.sh
source "$SNAP/lib/common.sh"

if [[ "$(id -u)" == 0 ]]; then
    read_config
    validate_config
    [[ "$DATABASE_MODE" == bundled ]] || exit 0
    drop_privileges "$SNAP/bin/postgres-launch"
fi

umask 077
export PGDATA="$SNAP_COMMON/postgresql/data"
socket_dir="$SNAP_COMMON/run/postgresql"
cd "$SNAP_COMMON/postgresql"
# Refuse incompatible or damaged data; never silently replace an old cluster.
if [[ -e "$PGDATA" ]]; then
    if [[ ! -f "$PGDATA/PG_VERSION" ]] || [[ "$(cat "$PGDATA/PG_VERSION")" != 18 ]]; then
        echo 'Bundled database is not a PostgreSQL 18 cluster; restore/migrate it explicitly.' >&2
        exit 1
    fi
else
    # An interrupted initdb can leave only this disposable temporary directory.
    temp_data="$(mktemp -d "$SNAP_COMMON/postgresql/init.XXXXXXXX")"
    trap 'rm -rf -- "$temp_data"' EXIT
    "$SNAP/usr/lib/postgresql/18/bin/initdb" -D "$temp_data" \
        -L "$SNAP/usr/share/postgresql/18" -U silo \
        --encoding=UTF8 --locale=C.UTF-8 --auth-local=peer --auth-host=scram-sha-256
    mv "$temp_data" "$PGDATA"
    trap - EXIT
fi

# Peer authentication admits only the snap service user, mapped to the dedicated
# cluster's silo role. No TCP listener or reusable database password is needed.
printf 'local all silo peer map=silo\n' > "$PGDATA/pg_hba.conf"
printf 'silo _daemon_ silo\n' > "$PGDATA/pg_ident.conf"
chmod 0700 "$socket_dir"
exec "$SNAP/usr/lib/postgresql/18/bin/postgres" -D "$PGDATA" \
    -c listen_addresses= -c unix_socket_directories="$socket_dir" \
    -c unix_socket_permissions=0700 -c logging_collector=off \
    -c dynamic_shared_memory_type=mmap
